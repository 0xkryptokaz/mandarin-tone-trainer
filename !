import soundfile as sf
from faster_whisper import WhisperModel


class ASRWrapper:
    def __init__(self, model_size: str = "base", device: str = "cpu", compute_type: str = "int8"):
        print(f"Loading faster-whisper model: {model_size} ({compute_type})...")
        # int8 quantization on CPU gives the lowest memory footprint and fastest inference
        self.model = WhisperModel(model_size, device=device, compute_type=compute_type)

    def transcribe(self, audio_path: str) -> dict:
        try:
            duration = sf.info(audio_path).duration
            if duration < 0.5:
                return {"text": "", "segments": []}
        except Exception:
            return {"text": "", "segments": []}

        try:
            # vad_filter=True strips silence/static before decoding, preventing hallucination/crashes
            segments_gen, _ = self.model.transcribe(
                audio_path,
                language="zh",
                word_timestamps=True,
                vad_filter=True,
            )

            segments_list = []
            full_text_parts = []

            for seg in segments_gen:
                full_text_parts.append(seg.text)
                words = [
                    {"word": w.word, "start": w.start, "end": w.end}
                    for w in (seg.words or [])
                ]
                segments_list.append({
                    "start": seg.start,
                    "end": seg.end,
                    "text": seg.text,
                    "words": words,
                })

            return {
                "text": "".join(full_text_parts).strip(),
                "segments": segments_list,
            }

        except Exception as exc:
            print(f"faster-whisper transcription error: {exc}")
            return {"text": "", "segments": []}

    def extract_syllable_intervals(self, transcription: dict) -> list[tuple[float, float]]:
        """Return a list of (start, end) seconds, one per Chinese character."""
        intervals = []
        for seg in transcription.get("segments", []):
            words = seg.get("words")
            if words:
                for w in words:
                    chars = [c for c in w.get("word", "") if "\u4e00" <= c <= "\u9fff"]
                    if not chars:
                        continue
                    step = (w["end"] - w["start"]) / len(chars)
                    for i in range(len(chars)):
                        intervals.append((w["start"] + i * step, w["start"] + (i + 1) * step))
            else:
                intervals.append((seg["start"], seg["end"]))
        return intervals
